# Used by docker-compose.yml. Copy to ".env" and fill in JWT_SECRET.
# (MongoDB needs no setting here — compose starts its own Mongo container.)

# REQUIRED. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the app is served on, and the matching public URL (used for CORS).
# In production set FRONTEND_URL to your real https:// domain.
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Optional Google login. Leave blank to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
